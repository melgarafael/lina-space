+    /// 1 alarme por NÓ, não por mensagem: o Maestro re-despachou 3× ao mesmo terminal surdo (3 `id`
+    /// distintos) → 1 item só (o nó está surdo, não cada mensagem), idade desde a 1ª retenção.
+    #[test]
+    fn retained_deaf_dedups_per_node() {
+        let mut q = AttentionQueue::new();
+        let alvo = NodeId::now_v7();
+        q.observe(&retained("msg_1", alvo, "prompt_not_ready"), T0);
+        q.observe(&retained("msg_2", alvo, "prompt_not_ready"), T0 + 30_000);
+        q.observe(&retained("msg_3", alvo, "prompt_not_ready"), T0 + 60_000);
+        let d = deaf(&q, T0 + 60_000 + RETAINED_DEAF_WINDOW_MS);
+        assert_eq!(d.len(), 1, "3 despachos ao mesmo nó surdo → 1 alarme");
+        assert_eq!(d[0].created_ts, T0, "idade ancora na 1ª retenção (mais antiga)");
+    }
