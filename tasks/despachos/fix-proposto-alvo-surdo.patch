+    fn retained(id: &str, to: NodeId, reason: &str) -> DomainEvent {
+        DomainEvent::MessageRetained {
+            id: id.into(),
+            to,
+            reason: reason.into(),
+        }
+    }
+
+    fn deaf(q: &AttentionQueue, now: u64) -> Vec<AttentionItem> {
+        q.items(now)
+            .into_iter()
+            .filter(|i| i.kind == AttentionKind::RetainedDeaf)
+            .collect()
+    }
+
+    /// "Alvo vivo mas surdo": uma mensagem RETIDA por `prompt_not_ready` que nunca chega vira
+    /// EXATAMENTE 1 alarme ao cruzar a janela (antes, nada — absorve o flicker fim-de-turno), e some
+    /// quando a MESMA `id` é finalmente entregue. É o ponto-cego que o engolido (arma só em
+    /// `MessageDelivered`) e o liveness (Dead só por EOF do PTY) deixavam silencioso até o DLQ (600 s).
+    #[test]
+    fn retained_deaf_raises_one_alarm_after_window_and_resolves_on_delivery() {
+        let mut q = AttentionQueue::new();
+        let alvo = NodeId::now_v7();
+        q.observe(&retained("msg_1", alvo, "prompt_not_ready"), T0);
+        // Antes da janela: nada (um turno real ENTREGA ou vira Busy em segundos → não é surdez).
+        assert_eq!(deaf(&q, T0 + RETAINED_DEAF_WINDOW_MS - 1).len(), 0);
+        // Cruzou a janela: 1 alarme, carregando o alvo, NUNCA aprovável (Choice — destrava no terminal).
+        let d = deaf(&q, T0 + RETAINED_DEAF_WINDOW_MS);
+        assert_eq!(d.len(), 1, "surdez persistente → 1 alarme precoce");
+        assert_eq!(d[0].node_id, alvo.to_string(), "o item carrega o alvo");
+        assert_ne!(d[0].prompt_kind, PromptKind::Yn);
+        // O CLI acordou e a MESMA id foi entregue → o aviso some (0 lixo preso).
+        q.observe(
+            &DomainEvent::MessageDelivered {
+                id: "msg_1".into(),
+                to: alvo,
+            },
+            T0 + RETAINED_DEAF_WINDOW_MS + 1,
+        );
+        assert_eq!(
+            deaf(&q, T0 + 2 * RETAINED_DEAF_WINDOW_MS).len(),
+            0,
+            "entregue → surdez resolvida"
+        );
+    }
+
+    /// Retenção por `target_busy` (colega TRABALHANDO, não surdo) NUNCA vira surdez — só
+    /// `prompt_not_ready` (lifecycle-julga-Idle mas grid-nunca-pronto) é o sinal. E ao escalar ao DLQ,
+    /// o item `DeadLetter` ASSUME (o aviso precoce some — sem alarme duplo para a mesma perda).
+    #[test]
+    fn retained_deaf_ignores_busy_and_yields_to_dlq() {
+        let mut q = AttentionQueue::new();
+        let busy = NodeId::now_v7();
+        q.observe(&retained("msg_b", busy, "target_busy"), T0);
+        assert_eq!(
+            deaf(&q, T0 + 10 * RETAINED_DEAF_WINDOW_MS).len(),
+            0,
+            "colega ocupado não é surdo"
+        );
+        // Surdez real que escala ao DLQ: o RetainedDeaf cede lugar ao DeadLetter.
+        let mudo = NodeId::now_v7();
+        q.observe(&retained("msg_d", mudo, "prompt_not_ready"), T0);
+        assert_eq!(deaf(&q, T0 + RETAINED_DEAF_WINDOW_MS).len(), 1);
+        q.observe(
+            &dead_lettered("msg_d", &mudo.to_string(), "estourou o teto"),
+            T0 + RETAINED_DEAF_WINDOW_MS + 1,
+        );
+        let now = T0 + 2 * RETAINED_DEAF_WINDOW_MS;
+        assert_eq!(deaf(&q, now).len(), 0, "DLQ assumiu → sem alarme precoce duplo");
+        assert_eq!(
+            q.items(now)
+                .iter()
+                .filter(|i| i.kind == AttentionKind::DeadLetter)
+                .count(),
+            1,
+            "a perda consumada vira DeadLetter"
+        );
+    }
